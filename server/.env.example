# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Security & Session
JWT_SECRET=ordo-illuminatorum-sanctum-secret-2026-lux-sapientia
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
# For local Postgres, Supabase, Neon, Render, or Railway:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/illuminati_db
# Or granular parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_password
# PGDATABASE=illuminati_db

# SMS Gateway Configuration
# Supported providers: smsethiopia, esms_africa
SMS_PROVIDER=smsethiopia

# SMSEthiopia (smsethiopia.com)
SMSETHIOPIA_API_KEY=YOUR_ACTUAL_API_KEY
SMSETHIOPIA_TEST_NUMBER=251908426432
SMSETHIOPIA_ENDPOINT=https://smsethiopia.com/api/sms/send

# eSMS Africa (esmsafrica.com)
ESMS_AFRICA_API_KEY=
ESMS_AFRICA_SENDER_ID=ORDO
ESMS_AFRICA_ENDPOINT=https://api.esmsafrica.com/v1/sms/send
